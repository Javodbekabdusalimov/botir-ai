// SQLite for the hackathon demo (zero setup). JSON fields are stored as String (JSON.stringify).
// Every table has soft delete (deletedAt).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Simple phone + password auth. role: business | user. businessId set for business owners.
model User {
  id           String    @id @default(uuid())
  name         String
  phone        String?   @unique // +998XXXXXXXXX; null for a Telegram-only (Mini App / bot) user
  passwordHash String? // scrypt: salt:hash (hex); null = no password login (Telegram-only)
  telegramId   String?   @unique // Telegram user id (decimal string), set by POST /auth/telegram or the bot
  role         String    @default("user")
  businessId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model Business {
  id             String    @id @default(uuid())
  name           String
  category       String
  address        String    @default("")
  district       String    @default("")
  geoLat         Float?
  geoLng         Float?
  workHours      String // JSON WorkHours
  maxDiscountPct Int       @default(0)
  rating         Float     @default(4.5) // unused: kept so plain `prisma db push` works on existing DBs
  distanceKm     Float     @default(3) // unused, same reason
  lang           String    @default("uz")
  ownerUserId    String    @default("demo-owner")
  isDemo         Boolean   @default(false)
  notes          String?
  plan           String    @default("start") // start | pro (subscription, paid via TezCheck)
  planUntil      DateTime?
  aiCredits      Int       @default(100) // monthly AI dialog quota
  agentReadyAt   DateTime? // first time the agent had a catalog + confirmed knowledge (onboarding time metric)
  syncKeyHash    String? // sha256 of the catalog sync API key (POS/1C/iiko push); plain key is shown once
  landmark       String? // nearest well-known place (geoLat/geoLng above hold the coordinates)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model CatalogItem {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  description String?
  price       Int
  unit        String    @default("dona")
  durationMin Int?
  inStock     Boolean   @default(true)
  tags        String    @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([businessId])
}

model Order {
  id            String    @id @default(uuid())
  businessId    String
  userId        String
  negotiationId String?
  offerId       String?   @unique
  items         String // JSON OrderItem[]
  total         Int
  discountPct   Int       @default(0)
  status        String    @default("draft")
  details       String? // JSON {when?, people?, wishes?} from the negotiated task
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([businessId])
}

model Booking {
  id         String    @id @default(uuid())
  businessId String
  userId     String
  orderId    String?
  start      DateTime
  end        DateTime
  people     Int?
  status     String    @default("pending_confirm")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

/// Incoming payments only (TezCheck create-bill + status polling). No refund/payout.
/// kind=order → orderId is Order.id; kind=subscription → orderId is a `sub-…` reference, businessId pays.
model Payment {
  id         String    @id @default(uuid())
  orderId    String
  kind       String    @default("order")
  businessId String?
  provider   String    @default("tezcheck")
  billId     String    @unique
  link       String
  amount     Int
  status     String    @default("pending")
  isTest     Boolean   @default(false)
  paidAt     DateTime?
  ownerType  String? // billing: who gets the plan when paid (user | business); null = legacy business subscription
  ownerId    String?
  plan       String? // billing: pro | max
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

model Negotiation {
  id        String    @id @default(uuid())
  userId    String
  text      String
  tasks     String // JSON NegotiationTask[]
  status    String    @default("running")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

/// Shared-contract NegotiationEvent log (SSE replay). Messages also land in NegotiationMessage.
model NegotiationEventLog {
  id            String   @id @default(uuid())
  negotiationId String
  seq           Int
  event         String // JSON NegotiationEvent
  createdAt     DateTime @default(now())

  @@index([negotiationId, seq])
}

model NegotiationMessage {
  id            String    @id
  negotiationId String
  businessId    String
  fromAgent     String
  round         Int
  text          String
  payload       String // JSON A2APayload
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  @@index([negotiationId])
}

/// Agent-layer offer (sessionId = `${negotiationId}:${businessId}`).
model AgentOffer {
  id            String    @id
  sessionId     String
  negotiationId String
  businessId    String
  items         String // JSON {productId,qty}[]
  total         Int
  discountPct   Int
  status        String
  upsell        String? // JSON {productId,name,price}, not in total
  taskId        String? // NegotiationTask.taskId, set when the lane finishes
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([negotiationId, businessId])
}

/// Owned by a business (inbox) or by a site user (personal Botir in their own Telegram).
model TgAccount {
  id                   String    @id
  ownerType            String    @default("business") // business | user
  businessId           String?
  userId               String?
  kind                 String
  tgUserId             String
  username             String?
  sessionEnc           String?
  businessConnectionId String?
  connectedAt          DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
}

/// B2C: something the AI wants to send from the user's own Telegram. Sent only after explicit approve.
model UserAction {
  id        String    @id @default(uuid())
  userId    String
  accountId String
  chatId    String
  peerTitle String
  text      String
  status    String    @default("pending") // pending | sending | sent | rejected | failed
  reason    String?
  firstContact       Boolean   @default(false) // outreach: first message to a peer that never wrote to us (PolicyGuard exception, max 5 new peers/day)
  externalBusinessId String? // outreach: ExternalBusiness this message is addressed to
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, status])
}

model Chat {
  id            String    @id
  accountId     String
  peerId        String
  title         String
  username      String?
  mode          String    @default("copilot")
  needsHuman    Boolean   @default(false)
  draft         String? // JSON Draft
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([accountId])
}

model InboxMessage {
  id        String    @id
  chatId    String
  tgMsgId   Int
  direction String
  author    String
  text      String
  sentAt    DateTime
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([chatId])
}

model MemoryFact {
  id         String    @id @default(uuid())
  userId     String
  fact       String
  weight     Float
  sessionId  String?
  businessId String?
  at         DateTime
  deletedAt  DateTime?

  @@index([userId])
}

model AuditFinding {
  id         String    @id @default(uuid())
  sessionId  String
  businessId String?
  type       String
  detail     String
  at         DateTime
  deletedAt  DateTime?
}

model LoopProposal {
  id               String    @id @default(uuid())
  businessId       String
  kind             String // agents ProposalKind: prompt | catalog | faq
  change           String
  reason           String
  sourceFindingIds String    @default("[]")
  evalBefore       Float?
  evalAfter        Float?
  status           String    @default("pending")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([businessId])
}

model PromptVersion {
  id                String    @id @default(uuid())
  businessId        String
  version           Int
  extraInstructions String
  status            String
  scoreBefore       Float?
  scoreAfter        Float?
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?

  @@index([businessId])
}

model GoldenCase {
  id         String    @id
  businessId String
  question   String
  expected   String // JSON string[]
  forbidden  String? // JSON string[]
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([businessId])
}

model PolicyViolation {
  id         String    @id @default(uuid())
  scope      String
  reason     String
  sessionId  String?
  businessId String?
  repaired   Boolean
  at         DateTime
  deletedAt  DateTime?
}

model LlmCall {
  id           String   @id @default(uuid())
  model        String
  ms           Int
  chars        Int
  purpose      String
  ok           Boolean
  at           DateTime
  errorKind    String? // auth | limit | overloaded | timeout | bad_output | other (only when ok=false)
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  userId       String? // billing owner of the call (billing/billing-context.ts), null = background work
  businessId   String?
}

// ---- Business knowledge: sources → draft facts → owner confirms → agent context ----
model KnowledgeSource {
  id         String    @id @default(uuid())
  businessId String
  kind       String // photo | pdf | text | telegram | website | voice | sync | question
  label      String
  status     String    @default("processing") // processing | ready | failed
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([businessId])
}

model KnowledgeFact {
  id            String    @id @default(uuid())
  businessId    String
  sourceId      String
  kind          String // profile | policy | faq | catalog | style
  topic         String // delivery, payment, booking, parking, ... | item name for catalog
  question      String? // faq
  content       String
  price         Int? // catalog only
  unit          String? // catalog only
  evidence      String? // short quote from the source (PII redacted)
  confidence    Float     @default(0.5)
  status        String    @default("draft") // draft | confirmed | rejected
  confirmedAt   DateTime?
  catalogItemId String? // set when a catalog fact was confirmed
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([businessId, status])
}

model PendingQuestion {
  id          String    @id @default(uuid())
  businessId  String
  question    String
  normalized  String
  timesAsked  Int       @default(1)
  status      String    @default("open") // open | answered | dismissed
  answer      String?
  factId      String?
  tgMessageId Int? // bot message sent to the owner (reply to it = answer)
  tgChatId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([businessId, normalized])
}

/// One business-agent turn. Source of the honest "AI answered X%" metric.
model AgentTurn {
  id         String   @id @default(uuid())
  businessId String
  channel    String // negotiation | inbox
  answered   Boolean // false = the agent did not know / needs a human
  createdAt  DateTime @default(now())

  @@index([businessId])
}

// ---- Billing: plan per owner + daily usage (see src/billing) ----
/// Paid plan of a user or a business. No row / expired = FREE. tokens are a DAILY allowance (DailyUsage), plan lasts 30 days per payment.
model PlanAccount {
  id        String    @id @default(uuid())
  ownerType String // user | business
  ownerId   String
  plan      String    @default("free") // free | pro | max
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([ownerType, ownerId])
}

/// Per owner and Asia/Tashkent day: FREE search requests used and tokens debited (real Claude input + output tokens).
model DailyUsage {
  id         String    @id @default(uuid())
  ownerType  String
  ownerId    String
  day        String // YYYY-MM-DD in Asia/Tashkent
  requests   Int       @default(0)
  tokensUsed Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@unique([ownerType, ownerId, day])
}

/// Public directory of businesses that are NOT Botir partners (imported from prisma/directory.json, create-only).
/// Unknown values stay null: nothing is guessed. The personal agent contacts them through `contacts`.
model ExternalBusiness {
  id          String    @id @default(uuid())
  dedupeKey   String    @unique // normalized name|address: importer idempotency
  name        String
  category    String
  district    String?
  address     String?
  landmark    String?
  lat         Float?
  lng         Float?
  workHours   String?
  contacts    String // JSON { telegramUser, telegramBot, telegramChannel, instagram, phone, website }
  sources     String // JSON string[] (at least one URL)
  retrievedAt String // ISO date the sources were read
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([category])
}

/// The user asked for a business we could not reach (no contact): the invite list.
model WantedBusiness {
  id        String    @id @default(uuid())
  userId    String
  category  String
  district  String?
  need      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([category, district])
}

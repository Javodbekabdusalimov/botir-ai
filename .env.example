# .env — FAQAT lokal (.gitignore da). Repoga hech qachon sir tushmaydi.

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
# SEO: kanonik sayt manzili (bo'sh bo'lsa production default ishlatiladi)
NEXT_PUBLIC_SITE_URL=
# Google Analytics 4 o'lchov ID (G-XXXXXXXXXX). Bo'sh bo'lsa skript umuman yuklanmaydi
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag tasdiqlash kodi (content qiymati)
NEXT_PUBLIC_GSC_VERIFICATION=

# API
PORT=4000
# apps/api/.env — SQLite file next to prisma/schema.prisma (path is relative to prisma/)
DATABASE_URL=file:./dev.db
# postgres://… or postgresql://… → Postgres (scripts/prisma.mjs swaps the provider; see apps/api/README.md "Prod baza")
# Password of the 2 seeded demo accounts. Empty → public default 'botir123' (set it in prod).
SEED_DEMO_PASSWORD=
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# sdk (default, Claude Agent SDK over the logged-in claude CLI) | cli (`claude -p`)
LLM_MODE=sdk
# Optional audio → text: executable that gets the audio path as its only argument and prints the transcript. Empty → audio upload answers 503.
STT_CMD=
JWT_SECRET=
# HS256 secret for /auth tokens (e.g. `openssl rand -hex 32`). Empty → random per boot (tokens die on restart).
AUTH_SECRET=change-me-openssl-rand-hex-32
TELEGRAM_BOT_TOKEN=
TG_API_ID=
TG_API_HASH=
TG_SESSION_KEY=
EMBED_URL=http://127.0.0.1:8766
# TezCheck merchant API (incoming payments only; status via polling, no webhook). Key set → real bills, else TEST links.
TEZCHECK_API_URL=https://api.tezcheck.uz/api/merchant/v1
TEZCHECK_CASH_DESK_CODE=
TEZCHECK_API_KEY=
# 1 → also accept "Test provider" payments (livemode=false) as paid. Default: real money only.
TEZCHECK_ACCEPT_TEST=
# Subscription (so'm / month) and monthly AI dialog quota
# First paid month of ANY plan (Pro or Max), once per account; then PLAN_PRO_PRICE / PLAN_MAX_PRICE every 30 days.
# PLAN_PRO_INTRO_PRICE is still read as a fallback alias of PLAN_INTRO_PRICE.
# Price = worst-case monthly AI cost + 40% (~12 000 so'm/$). Tokens = real Claude input+output tokens, DAILY, reset 00:00 Asia/Tashkent.
PLAN_INTRO_PRICE=1000
PLAN_PRO_PRICE=82000
PLAN_MAX_PRICE=163000
PLAN_PRO_DAILY_TOKENS=100000
PLAN_MAX_DAILY_TOKENS=200000
# FREE: search requests per day (POST /agent/search)
PLAN_FREE_DAILY_REQUESTS=3
# 1 → POST /agent/request, /negotiations/:id/confirm and tg-connect/start answer 402 for FREE owners. 0 → log only.
BILLING_ENFORCE=0
# Daily cap on ALL Claude tokens (every client + guests, one owner account). At the cap new AI calls fail fast. 0 = no cap.
AI_GLOBAL_DAILY_TOKENS=3000000
PLAN_PRO_CREDITS=1000
PLAN_START_CREDITS=100
# Knowledge sources per business per day; parallel LLM calls; LLM effort
KNOWLEDGE_DAILY_CAP=30
AGENT_RATE_LIMIT=30   # /agent/request per IP and per user, 10-minute window
AGENT_DAILY_CAP=200
TRUST_PROXY_HOPS=1
LLM_MAX_CONCURRENCY=2
LLM_EFFORT=low

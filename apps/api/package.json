{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start:dev": "prisma db push --skip-generate && tsx src/seed.ts && tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@botir/shared": "workspace:*",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@prisma/client": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "0.18.5"
  }
}

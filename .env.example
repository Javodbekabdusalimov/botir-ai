# .env — FAQAT lokal (.gitignore da). Repoga hech qachon sir tushmaydi.

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# API
PORT=4000
# apps/api/.env — SQLite file next to prisma/schema.prisma (path is relative to prisma/)
DATABASE_URL=file:./dev.db
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# sdk (default, Claude Agent SDK over the logged-in claude CLI) | cli (`claude -p`)
LLM_MODE=sdk
JWT_SECRET=
# HS256 secret for /auth tokens (e.g. `openssl rand -hex 32`). Empty → random per boot (tokens die on restart).
AUTH_SECRET=change-me-openssl-rand-hex-32
TELEGRAM_BOT_TOKEN=
TG_API_ID=
TG_API_HASH=
TG_SESSION_KEY=
EMBED_URL=http://127.0.0.1:8766
# TezCheck merchant API (incoming payments only; status via polling, no webhook). Key set → real bills, else TEST links.
TEZCHECK_API_URL=https://api.tezcheck.uz/api/merchant/v1
TEZCHECK_CASH_DESK_CODE=
TEZCHECK_API_KEY=
# 1 → also accept "Test provider" payments (livemode=false) as paid. Default: real money only.
TEZCHECK_ACCEPT_TEST=
# Subscription (so'm / month) and monthly AI dialog quota
PLAN_PRO_PRICE=1000
PLAN_PRO_CREDITS=1000
PLAN_START_CREDITS=100
